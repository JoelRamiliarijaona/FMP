{
  "kind": "collectionType",
  "collectionName": "product_addons",
  "info": {
    "singularName": "product-addon",
    "pluralName": "product-addons",
    "displayName": "Product Addon",
    "description": "Produits et add-ons FMP"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "longDescription": {
      "type": "richtext"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "product.product-feature"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "icon": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["product", "addon"],
      "default": "product"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
